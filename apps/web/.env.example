# Copy to .env.local
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# PostHog analytics (optional; nothing is sent when empty)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Optional accounts (Neon Auth). Leave empty to keep the site account-free.
# NEON_AUTH_BASE_URL: the branch's Auth URL (Neon console > Auth, or `neon neon-auth status --branch dev`).
# NEON_AUTH_COOKIE_SECRET: 32+ random characters (openssl rand -base64 32). NEXT_PUBLIC_ACCOUNTS=1 shows Sign in.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_ACCOUNTS=
