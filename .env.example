# Copy to .env (never commit .env). Read by services/api and services/harvester.

# Local docker-compose Postgres (port 5433 to avoid clashing with any local install)
DATABASE_URL=postgresql://scholarlens:scholarlens@localhost:5433/scholarlens

# OpenAlex: free key from https://openalex.org/settings/api (needed to page past 200 results)
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# Anthropic: powers the agent reports (trend/search work without it)
ANTHROPIC_API_KEY=
# Model per tier. Defaults are claude-opus-5-5 for both. Setting the fast tier to
# claude-haiku-5-5 cuts cost a lot for the narrow agents, at some quality cost.
# LLM_FAST_MODEL=claude-opus-5-5
# LLM_STRONG_MODEL=claude-opus-5-5

# Cost guardrails
AGENT_RUNS_PER_CLIENT_PER_DAY=5
AGENT_RUNS_GLOBAL_PER_DAY=300

# Allowed web origins (JSON list)
CORS_ORIGINS=["http://localhost:3000"]
