# ScholarLens Environment Variables
# Copy this to .env and fill in your values

# Database
DB_PATH=data/research.db
PAPERS_DIR=data/papers/Papers

# ArXiv
ARXIV_FETCH_LIMIT=100

# Semantic Scholar (get yours at https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Similarity threshold for search results
SIMILARITY_THRESHOLD=0.20
