# Copy to .env (never commit .env). Read by services/api and services/harvester.

# Local docker-compose Postgres (port 5433 to avoid clashing with any local install)
DATABASE_URL=postgresql://scholarlens:scholarlens@localhost:5433/scholarlens

# OpenAlex: free key from https://openalex.org/settings/api (needed to page past 200 results)
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# AI reports (agents). Trends and search work without any key.
# Free option: Google AI Studio key from https://aistudio.google.com/apikey (no card needed).
# Note: on the free tier Google may use prompts to improve its products.
GEMINI_API_KEY=
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_STRONG_MODEL=gemini-3.6-flash

# Paid option: Anthropic. Used if no Gemini key is set, or when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# ANTHROPIC_STRONG_MODEL=claude-opus-5-5

# LLM_PROVIDER=auto   # auto | gemini | anthropic

# Cost guardrails
AGENT_RUNS_PER_CLIENT_PER_DAY=5
AGENT_RUNS_GLOBAL_PER_DAY=100

# Allowed web origins (JSON list)
CORS_ORIGINS=["http://localhost:3000"]
