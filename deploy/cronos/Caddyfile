api.rstackhub.in {
	# Compress JSON only. Server-sent events (Copilot answers) must stream through untouched:
	# compressing them buffers the stream and can break long answers mid-way.
	encode {
		gzip
		match {
			header Content-Type application/json*
		}
	}
	reverse_proxy api:8000 {
		flush_interval -1
	}
}
